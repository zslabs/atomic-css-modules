{
  "name": "atomic-css-modules-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "prepare": "if [ -x node_modules/.bin/simple-git-hooks ]; then simple-git-hooks; fi",
    "build": "npm run build -w @zslabs/atomic-css-modules",
    "test": "npm run test -w @zslabs/atomic-css-modules",
    "test:watch": "npm run test:watch -w @zslabs/atomic-css-modules",
    "bench": "npm run bench -w @zslabs/atomic-css-modules",
    "registry": "npm run dump-registry -w @zslabs/atomic-css-modules --",
    "type:check": "npm run type:check -w @zslabs/atomic-css-modules",
    "lint": "oxlint . --fix",
    "lint:css": "stylelint \"**/*.{css,module.css}\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "web": "npm run dev -w web",
    "web:build": "npm run build -w web",
    "web:start": "npm run start -w web",
    "tokens:snippets": "npm run tokens:snippets -w web",
    "tokens:hover:install": "node ./extensions/design-token-hover/install.mjs"
  },
  "devDependencies": {
    "nano-staged": "1.0.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "simple-git-hooks": "2.14.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-use-logical": "2.1.3",
    "typescript": "7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  }
}
