{
  "name": "@zslabs/atomic-css-modules",
  "version": "0.4.0",
  "description": "Extract repeated CSS Modules declarations into shared atomic classes",
  "keywords": [
    "atomic-css",
    "css-modules",
    "nextjs",
    "postcss",
    "rspack",
    "rspack-plugin",
    "vite",
    "vite-plugin",
    "webpack",
    "webpack-plugin"
  ],
  "homepage": "https://github.com/zslabs/atomic-css-modules/tree/main/packages/atomic-css-modules#readme",
  "bugs": {
    "url": "https://github.com/zslabs/atomic-css-modules/issues"
  },
  "license": "MIT",
  "author": "Zach Schnackel <info@zslabs.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zslabs/atomic-css-modules.git",
    "directory": "packages/atomic-css-modules"
  },
  "files": [
    "dist",
    "registry.css",
    "GUIDE.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/cjs/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/cjs/vite-plugin.cjs",
      "default": "./dist/cjs/vite-plugin.cjs"
    },
    "./postcss": {
      "types": "./dist/postcss-plugin.d.ts",
      "import": "./dist/postcss-plugin.js",
      "require": "./dist/cjs/postcss-plugin.cjs",
      "default": "./dist/cjs/postcss-plugin.cjs"
    },
    "./webpack": {
      "types": "./dist/webpack-plugin.d.ts",
      "import": "./dist/webpack-plugin.js",
      "require": "./dist/cjs/webpack-plugin.cjs",
      "default": "./dist/cjs/webpack-plugin.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.json && node ./scripts/build-cjs.mjs",
    "type:check": "tsc --project tsconfig.json --pretty --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "dump-registry": "node --experimental-strip-types ./scripts/dump-registry.ts"
  },
  "dependencies": {
    "lightningcss": "1.33.0",
    "mdn-data": "2.37.0"
  },
  "devDependencies": {
    "@rspack/core": "2.2.9",
    "@types/node": "26.6.2",
    "css-loader": "7.1.5",
    "esbuild": "0.28.2",
    "less": "4.9.1",
    "less-loader": "13.1.0",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.32",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "webpack": "5.112.2"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0",
    "css-loader": "^7.0.0",
    "postcss": "^8.0.0",
    "vite": "^8.0.0",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "css-loader": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.17.0 || >=22.5.0"
  }
}
